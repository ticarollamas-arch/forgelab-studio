{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "github-app": {
      "root": "modules/github-intelligence/artifacts/github-intelligence",
      "framework": "vite",
      "buildCommand": "BASE_PATH=/ PORT=3000 pnpm --dir ../.. --filter @workspace/github-intelligence build",
      "outputDirectory": "dist/public"
    },
    "api": {
      "root": "modules/github-intelligence/artifacts/api-server",
      "runtime": "node",
      "buildCommand": "pnpm --dir ../.. --filter @workspace/api-server build",
      "entrypoint": "dist/index.mjs"
    },
    "ziptogit": {
      "root": "modules/ziptogit",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "hackmind": {
      "root": "modules/hackmind",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/ziptogit/(.*)",
      "destination": { "service": "ziptogit" }
    },
    {
      "source": "/hackmind/(.*)",
      "destination": { "service": "hackmind" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "github-app" }
    }
  ]
}
